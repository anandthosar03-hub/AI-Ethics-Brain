{
  "version": "1.0.0",
  "max_prompt_chars": 20000,
  "max_context_chars": 60000,
  "max_output_chars": 12000,
  "grounding_mode": "strict",
  "block_prompt_injection": true,
  "block_harmful_requests": true,
  "block_secret_leaks": true,
  "block_sensitive_identifiers": true,
  "repeated_line_limit": 5,
  "allowed_actions": [
    "search_docs",
    "read_dashboard"
  ],
  "action_names_always_blocked": [
    "exfiltrate_credentials",
    "steal_credentials",
    "deploy_ransomware",
    "disable_security_controls",
    "wipe_host",
    "delete_backups_and_logs"
  ],
  "action_risk_terms": [
    "delete",
    "remove",
    "wipe",
    "drop_database",
    "transfer",
    "payment",
    "purchase",
    "send_email",
    "send_message",
    "publish",
    "deploy",
    "shell",
    "execute",
    "run_command",
    "grant_permission",
    "revoke_permission",
    "modify_account",
    "write_file",
    "database_write",
    "change_password",
    "hiring_decision",
    "medical_decision",
    "credit_decision",
    "legal_decision",
    "education_decision",
    "housing_decision",
    "eligibility_decision",
    "employee_termination",
    "facial_recognition_match",
    "rank_applicant"
  ]
}
